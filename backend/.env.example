# ============================================================
# ComplyFlow Backend — Environment Variables Template
# Copy to backend/.env or root .env
# ============================================================

APP_ENV=development
LOG_LEVEL=INFO

# Gemini AI Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# SQLite Database (Local-first)
DATABASE_PATH=complyflow.db

# Storage & Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=52428800

# Server & Network
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Security & Sessions
SESSION_SECRET=change-this-to-a-secure-random-secret-in-production-32chars!
CSRF_SECRET=change-this-to-a-secure-random-csrf-secret-in-production!
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true
SESSION_LIFETIME_SECONDS=604800
