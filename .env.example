# ============================================================
# ComplyFlow — Production & Development Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# LOCAL-FIRST ARCHITECTURE:
#   FastAPI -> SQLite -> Local File Storage -> Gemini API
#   Google Cloud / Vertex AI is NOT required.
# ============================================================

# --- Environment Mode ---
# Options: development | production | testing
APP_ENV=development
LOG_LEVEL=INFO

# --- AI Layer (Google Gemini API via Google ADK) ---
# Required for live verification (get key from: https://aistudio.google.com/apikey)
# Tests and deterministic audits run offline without requiring an API key.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# --- Database (SQLite Primary, Local-First) ---
# Database file location (stored locally, zero external database dependencies)
DATABASE_PATH=complyflow.db

# --- Document & Evidence Storage ---
# Local directory for uploaded requirements, evidence PDFs, and generated reports
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=52428800

# --- Server & Networking ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed origins (no wildcards allowed with credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Authentication, Session & Cookie Security ---
# In production, SESSION_SECRET must be a unique, cryptographically random string (min 32 chars)
SESSION_SECRET=change-this-to-a-secure-random-secret-in-production-32chars!
CSRF_SECRET=change-this-to-a-secure-random-csrf-secret-in-production!
# Set COOKIE_SECURE=true when deploying behind HTTPS in production
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true
SESSION_LIFETIME_SECONDS=604800

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8000
